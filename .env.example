# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://yotrack:password@localhost:5432/yotrack
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=yotrack
DATABASE_USER=yotrack
DATABASE_PASSWORD=

# ─── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── TCP Gateway ────────────────────────────────────
GATEWAY_PORT=5023
GATEWAY_HOST=0.0.0.0
# Shared secret between gateway and API — use a long random string
INTERNAL_API_KEY=
# Gateway calls this to save telemetry (internal, same server)
API_URL=http://localhost:3000/api/v1

# ─── API Server ─────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
