{
  "expo": {
    "name": "Trackvee",
    "slug": "trackvee-mobile",
    "scheme": "trackvee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/trackvee-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trackvee.mobile"
    },
    "android": {
      "package": "com.trackvee.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/trackvee-app-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/trackvee_alert.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Trackvee to resolve the address of a selected vehicle history point."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e702258-0bf7-46b4-a447-ac2cbdc4c6f0"
      }
    },
    "owner": "bilalxmughal"
  }
}
