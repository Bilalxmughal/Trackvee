{
  "expo": {
    "name": "Trackvee",
    "slug": "trackvee-mobile",
    "scheme": "trackvee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/trackvee-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trackvee.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.trackvee.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/trackvee-app-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/trackvee_alert.wav",
            "./assets/trackvee_chime.wav",
            "./assets/trackvee_pulse.wav",
            "./assets/trackvee_bell.wav",
            "./assets/trackvee_soft.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Trackvee to resolve the address of a selected vehicle history point."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e702258-0bf7-46b4-a447-ac2cbdc4c6f0"
      }
    },
    "owner": "bilalxmughal"
  }
}
